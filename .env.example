# Copy to .env (gitignored) and fill in. Never commit the real .env.

# Nebius Token Factory -- embeddings and generation.
# Log in at https://tokenfactory.nebius.com  (Token Factory, NOT AI Cloud)
# then: API keys -> create key
NEBIUS_API_KEY=paste-your-nebius-key-here

# SEC EDGAR requires a real name + email or it blocks requests.
# This is the most common reason a fetch script silently fails.
SEC_USER_AGENT=Your Name you@example.com

# Optional: LangSmith tracing. Free tier gives per-run traces, which makes
# latency collection trivial and failure analysis much easier to write up.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=restated
